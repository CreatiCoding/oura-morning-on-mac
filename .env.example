# WakeReady 설정 예시 — 복사해서 .env 로 쓰고 실제 값 채우기 (.env 는 gitignore)
# cp .env.example .env

# --- 링 인증 (M1에서 iPhone 백업으로 추출) ---
OURA_AUTH_KEY=<16바이트 auth_key hex 32자>          # key.hex 로도 저장됨

# --- 알람: 아이폰 iMessage 트리거 (권장) ---
# 맥 → iMessage 로 WAKE_TRIGGER_WORD 발송 → 아이폰 단축어 자동화가 노래/유튜브 재생.
# 아이폰 설정: 단축어 앱 > 자동화 > 메시지 트리거 > "메시지 포함 내용"=WAKEREADY > "즉시 실행"
#              > 동작: 볼륨 100% 설정 → URL 열기(유튜브) 또는 음악 재생
IMESSAGE_TARGET=+8210XXXXXXXX                        # 아이폰 번호 (국가코드 포함)
WAKE_TRIGGER_WORD=WAKEREADY
IMESSAGE_REPEAT=3                                    # 재전송 횟수(ACK 없을 때)
IMESSAGE_GAP_SEC=20

# 재생 확인(ACK): 아이폰 단축어 마지막에 ntfy로 "PLAYED" 신호를 보내면
# 맥이 실제 재생을 확인. 미수신 시 재전송→폴백 에스컬레이션.
# 단축어 동작: "URL의 콘텐츠 가져오기" URL=https://ntfy.sh 방법=POST
#   요청본문=JSON {topic: <아래값>, message: PLAYED}
NTFY_ACK_TOPIC=wakeready-ack-xxxxxx
ACK_WAIT_SEC=30                                      # ACK 대기 시간(초)

# --- 판정 로직 ---
TARGET_SLEEP_HOURS=8                                 # 목표 수면 시간
POLL_INTERVAL_MIN=10                                 # 폴링 간격(분)
CAP_TIME=09:00                                       # 안전 상한 시각(무조건 기상)

# --- 알람 폴백 (선택) ---
# NTFY_TOPIC=wakeready-xxxxxxxx                       # ntfy 반복 푸시(≤30초음)
# LOCAL_SONG=/path/to/song.mp3                        # 맥이 침실 근처일 때만
# ALARM_SECONDS=120

# --- iPhone 백업 관련 (M1 1회성, 이후 불필요) ---
# IPHONE_ENCRYPTED_BACKUP_PW=<암호화 백업 암호>
